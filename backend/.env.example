# Application Environment Variables
PROJECT_NAME="Student Collaboration & Networking Platform"
VERSION="1.0.0"
API_V1_STR="/api"
ENV="development"

# Security
SECRET_KEY="dev-secret-key-change-this-in-production-super-secret-key-12345"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Local SQLite for immediate out-of-box dev: sqlite:///./student_platform.db
# PostgreSQL / Supabase for production: postgresql://user:password@host:5432/dbname
DATABASE_URL="sqlite:///./student_platform.db"

# CORS Configuration
FRONTEND_URL="http://localhost:5173"
